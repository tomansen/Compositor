    "“%@” is a folder, which has no pixels of its own. Paint on a layer inside it, or on the folder’s mask.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是组，本身没有像素。请在其内部的图层或该组的蒙版上绘制。"
          }
        }
      }
    },
    "“%@” is an adjustment layer, with no pixels to paint. Paint on its mask instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是调整图层，没有可绘制的像素。请在它的蒙版上绘制。"
          }
        }
      }
    },
    "“%@” is hidden, or inside a hidden folder. Show it to paint on it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已隐藏，或位于隐藏的组内。请先显示它再绘制。"
          }
        }
      }
    },
    "“%@” was changed on disk.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已在磁盘上被更改。"

    "Three-Way": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三向"
          }
        }
      }
    },
    "Three-Way shows shadows, midtones, and highlights. The other choices show one wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三向显示阴影、中间调和高光。其他选项仅显示一个色轮。"
          }
        }
      }
    },
    "Threshold": {

            "state": "translated",
            "value": "强度"
          }
        }
      }
    },
    "Strengthens or weakens every color by the same amount.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以相同幅度增强或减弱所有颜色。"
          }
        }
      }
    },
    "Strengthens or weakens the blue primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱蓝色原色。"
          }
        }
      }
    },
    "Strengthens or weakens the green primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱绿色原色。"
          }
        }
      }
    },
    "Strengthens or weakens the red primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱红色原色。"
          }
        }
      }
    },
    "Strengthens quiet colors more than colors that are already strong, and protects skin tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对较淡的颜色增强幅度大于已较浓的颜色，并保护肤色。"
          }
        }
      }
    },
    "Stretches width relative to height.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相对于高度拉伸宽度。"
          }
        }
      }
    },
    "Stroke": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {

    },
    "This adjustment type isn’t supported and was skipped.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此调整类型，已跳过。"
          }
        }
      }
    },
    "This clipping mask’s base isn’t supported, so clipping was skipped.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此剪贴蒙版的基底，因此已跳过剪贴。"
          }
        }
      }
    },
    "This import exceeds the current %lld-megapixel document budget or %@-pixel side limit.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此导入超出当前 %lld 百万像素的文稿预算或每边 %@ 像素的限制。"
          }
        }
      }
    },
    "This is not a valid Compositor project, or its metadata is damaged.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是有效的 Compositor 项目，或其元数据已损坏。"
          }
        }
      }
    },
    "This layer supplies a live mask": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图层提供实时蒙版"
          }
        }
      }
    },
    "This project exceeds the supported canvas, layer, file-size, or %lld-megapixel document limit.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目超出支持的画布、图层、文件大小或 %lld 百万像素文稿限制。"
          }
        }
      }
    },
    "This project uses format version %lld. This app supports versions %lld–%lld.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目使用格式版本 %lld。此应用支持版本 %lld–%lld。"

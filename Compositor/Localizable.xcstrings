    "Tonal Contrast": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色调对比"
          }
        }
      }
    },
    "Tones": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色调"
          }
        }
      }
    },
    "Tones from black on the left to white on the right: blacks, shadows, midtones, highlights, whites. Control-click to show the vectorscope.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影调从左端的黑色到右端的白色：黑色、阴影、中间调、高光、白色。按住 Control 点击可显示矢量示波器。"
          }
        }
      }
    },
    "Tones per channel: 2 is pure black and white": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个通道的影调数：2 表示纯黑与纯白"
          }
        }
      }
    },
    "Top": {
      "localizations": {
        "zh-Hans": {
